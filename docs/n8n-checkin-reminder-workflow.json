{
  "name": "Mellyna - Check-in Reminder Cron",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      },
      "id": "d4e5f6a7-b8c9-4012-8def-234567890123",
      "name": "Every 5 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [220, 240],
      "notes": "Absen dibuka 30 menit sebelum sesi. Dengan interval 5 menit, pengingat terkirim paling lambat 25 menit sebelum sesi mulai."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:3000/api/cron/checkin-reminders?secret=change-this-to-random-secret",
        "options": {}
      },
      "id": "e5f6a7b8-c9d0-4123-9ef0-345678901234",
      "name": "Send Check-in Reminders",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 240],
      "notes": "Ganti URL dan secret sesuai server (sama seperti workflow Report Digest). Endpoint hanya mengirim satu WA per jadwal ke tutor yang belum absen."
    }
  ],
  "connections": {
    "Every 5 minutes": {
      "main": [
        [
          {
            "node": "Send Check-in Reminders",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  }
}
